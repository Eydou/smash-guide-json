d. Damage-based armor on frames 34—63, but it does not apply when used from the air unless landing on frame 34 or earlier. Damage-based armor takes 36.0% damage in 1v1 and 30% damage in FFA/doubles.","damage":"Grounded: 30.0/8.0 (Aerial: 25.0/6.0)","shieldLag":"25/22","shieldStun":"**","hitbox":"Hit/Shockwave","onShield":"**","active":"62—67/2—5","endlag":"66"}]},{"key":"grabs","moves":[{"name":"Grab","startup":"6","total":"39","active":"6—7","endlag":"32"},{"name":"Dash Grab","startup":"10","total":"48","active":"10—11","endlag":"37"},{"name":"Pivot Grab","startup":"11","total":"42","active":"11—12","endlag":"30"},{"name":"Pummel","startup":"1","total":"22","landingLag":"**","notes":"Total frames includes 17 frames of hitlag (plus one in 1v1)","damage":"**"},{"name":"Forward Throw","startup":"13","total":"35","damage":"6.0"},{"name":"Backward Throw","startup":"30","total":"43","damage":"7.0"},{"name":"Up Throw","startup":"15","total":"37","damage":"9.0"},{"name":"Down Throw","startup":"13","total":"31","damage":"5.0"}]},{"key":"dodges","moves":[{"name":"Spot Dodge","total":"20/25","notes":"Intangible on frame 3-17"},{"name":"Forward Roll","total":"29","notes":"Intangible on frame 4-15"},{"name":"Backward Roll","total":"34","notes":"Intangible on frame 5-16"},{"name":"Neutral Air Dodge","total":"49","landingLag":"**","notes":"Intangible on frame 3-30"},{"name":"Air Dodge, Down","total":"68","landingLag":"**","notes":"Intangible on frame 3-21"},{"name":"Air Dodge, Diagonally Down","total":"76","landingLag":"**","notes":"Intangible on frame 3-21"},{"name":"Air Dodge, Left/Right","total":"83","landingLag":"**","notes":"Intangible on frame 3-21"},{"name":"Air Dodge, Diagonally Up","total":"97","landingLag":"**","notes":"Intangible on frame 3-21"},{"name":"Air Dodge, Up","total":"111","landingLag":"**","notes":"Intangible on frame 3-21"}]}],"stats":[{"label":"Weight","value":"97"},{"label":"Gravity","value":"0.089"},{"label":"Walk Speed","value":"0.97"},{"label":"Run Spe